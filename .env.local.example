# ─── Supabase ────────────────────────────────────────────────────────────────
# Project URL and anon key are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service role bypasses RLS — server only. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── BYOK envelope encryption ────────────────────────────────────────────────
# 32-byte key used to encrypt user-supplied OpenAI/Anthropic/Gemini keys
# at rest. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# ─── Deepgram voice (STT + TTS) ──────────────────────────────────────────────
# Master key used to mint short-lived scoped keys for the browser.
DEEPGRAM_API_KEY=
DEEPGRAM_PROJECT_ID=

# ─── Provider model defaults ─────────────────────────────────────────────────
# Override what each provider ID maps to. Defaults are reasonable; set these
# only if you want a specific model per provider.
OPENAI_MODEL_DEFAULT=gpt-5
ANTHROPIC_MODEL_DEFAULT=claude-opus-4-7
GEMINI_MODEL_DEFAULT=gemini-2.5-pro

# ─── Optional: Inngest (background jobs) ─────────────────────────────────────
# Required only if you want the nightly routine-detection job to run in
# production. Local dev uses the inline dev server.
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# ─── Optional: web-push (browser notifications) ──────────────────────────────
# Generate with: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# ─── OpenAI platform key for memory (M0) ─────────────────────────────────────
# Server-side, platform-managed (not BYOK). Powers two things:
#   - Embeddings (text-embedding-3-small, 1536-d) for episodic recall
#   - Sleep-time consolidation (gpt-4o-mini, strict-JSON + critique bridge)
# Get a key at https://platform.openai.com/account/api-keys
OPENAI_API_KEY=
# Optional override; default is text-embedding-3-small (1536-d).
# Changing this requires re-embedding existing rows + rebuilding the HNSW index.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
